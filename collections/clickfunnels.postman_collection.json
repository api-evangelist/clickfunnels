  "info": {
    "_postman_id": "22a7c8fb-31b3-47a8-84c1-0c9628561c17",
    "name": "ClickFunnels 2.0 API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "REST API for managing workspaces, funnels, pages, products, contacts,\norders, subscriptions, and fulfillments in ClickFunnels 2.0.\nAccount-level resources (teams, workspaces) are served from\nhttps://accounts.myclickfunnels.com. Workspace-scoped resources are served\nfrom a per-workspace subdomain (https://{workspace}.myclickfunnels.com).\nAuthentication uses a Bearer access token; a User-Agent header is required.\n\n\nContact Support:\n Name: ClickFunnels Developers",
      "type": "text/plain"
    }
  }
